# Publishable credentials only. Never put service_role/secret keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional future SEC provider; not needed by the snapshot/CSV workflow.
SEC_USER_AGENT=

# Server only. Choose an available model ID from the Google models API.
# Do not prefix with NEXT_PUBLIC_. AI stays disabled until both are configured.
GEMINI_API_KEY=
GEMINI_MODEL=
